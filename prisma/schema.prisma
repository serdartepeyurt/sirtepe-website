generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  excerpt   String?
  tags      String? @default("[]")
  published Boolean  @default(false)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
